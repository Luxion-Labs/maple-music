{
  "$schema": "https://biomejs.dev/schema/biomejson.json",
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "aide": {
        "noAlphaNumericIdentifierLength": [2, { "max": 64 }]
      }
    }
  },
  "formatter": {
    "enabled": true
  }
}